{
  "name": "Kek",
  "scopeName": "source.kek",
  "fileTypes": [
    "kek"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#chars"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#types"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#member-access"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.kek",
          "begin": "//",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.kek"
            }
          },
          "end": "$\\n?"
        },
        {
          "name": "comment.block.kek",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.kek"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.kek"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            }
          ]
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.kek",
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.kek"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.kek"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.kek",
          "match": "\\\\[nrt\"'\\\\]"
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.kek",
      "begin": "'",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.kek"
        }
      },
      "end": "'",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.kek"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.kek",
          "match": "\\\\[nrt\"'\\\\]"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.function.definition.kek",
          "match": "\\b(fun)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "storage.type.function.kek"
            },
            "2": {
              "name": "entity.name.function.kek"
            }
          }
        },
        {
          "name": "meta.type.definition.kek",
          "match": "\\b(struct|enum|class|impl|mod)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "storage.type.kek"
            },
            "2": {
              "name": "entity.name.type.kek"
            }
          }
        },
        {
          "name": "meta.import.kek",
          "match": "\\b(import|use)\\s+([A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "keyword.control.import.kek"
            },
            "2": {
              "name": "entity.name.namespace.kek"
            }
          }
        }
      ]
    },
    "keywords": {
      "name": "keyword.control.kek",
      "match": "\\b(import|from|as|pub|mod|use|const|var|fun|struct|enum|impl|class|if|else|match|while|for|in|break|continue|return)\\b"
    },
    "constants": {
      "name": "constant.language.kek",
      "match": "\\b(true|false|None|this|super)\\b"
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.builtin.kek",
          "match": "\\b(Num|Bool|String|Char|Byte|Void|Array)\\b"
        },
        {
          "name": "entity.name.type.kek",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.kek",
          "match": "\\b0[xX][0-9A-Fa-f]+\\b"
        },
        {
          "name": "constant.numeric.decimal.kek",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },
    "member-access": {
      "name": "meta.member.access.kek",
      "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)\\b",
      "captures": {
        "1": {
          "name": "punctuation.accessor.kek"
        },
        "2": {
          "name": "support.function.member.kek"
        }
      }
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.kek",
          "match": "->|=>|==|!=|<=|>=|&&|\\|\\||<<|>>|\\+=|-=|\\*=|/=|%=|[+\\-*/%=<>!&|^?]"
        }
      ]
    },
    "punctuation": {
      "name": "punctuation.separator.kek",
      "match": "::|[(){}\\[\\],.;:]"
    }
  }
}
