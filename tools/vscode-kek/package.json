{
  "name": "kek-language",
  "displayName": "Kek Language Support",
  "description": "Syntax highlighting and language configuration for the Kek language.",
  "version": "0.1.0",
  "publisher": "kekar",
  "license": "MIT",
  "files": [
    "language-configuration.json",
    "syntaxes/**",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/vladsaratovskyi/kekar.git",
    "directory": "tools/vscode-kek"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "kek",
        "aliases": [
          "Kek",
          "kek"
        ],
        "extensions": [
          ".kek"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kek",
        "scopeName": "source.kek",
        "path": "./syntaxes/kek.tmLanguage.json"
      }
    ]
  }
}
